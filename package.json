{
  "name": "india-learns",
  "version": "0.1.0",
  "private": true,
  "description": "India Learns — LMS for LUC's in-person Diploma Programs (Aviation, Retail & Fashion).",
  "type": "module",
  "engines": {
    "node": ">=20.12 <21",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev -w api\" \"npm:dev -w web\"",
    "build": "npm run build -w india-learns-shared-types && npm run build -w api && npm run build -w web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w india-learns-shared-types && npm run typecheck -w api && npm run typecheck -w web",
    "test": "npm test -w api"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.7.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.7.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^15.8.0",
    "prettier": "^3.3.3",
    "typescript": "5.4.5",
    "typescript-eslint": "^8.0.0"
  }
}
