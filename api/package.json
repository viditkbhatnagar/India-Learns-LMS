{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "India Learns API — Express 4 + Mongoose 8.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed:superadmin": "tsx scripts/seed-superadmin.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:entrance": "tsx scripts/seed-entrance-exam.ts",
    "backfill:personal-details": "tsx scripts/backfill-personal-details.ts",
    "migrate:gridfs-to-s3": "tsx scripts/migrate-gridfs-to-s3.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@sentry/node": "^8.40.0",
    "@types/multer": "^2.1.0",
    "argon2": "^0.40.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "india-learns-shared-types": "*",
    "jose": "^5.10.0",
    "mongoose": "^8.5.1",
    "multer": "^2.1.1",
    "nanoid": "^5.0.7",
    "pdfkit": "^0.15.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "@types/pdfkit": "^0.13.4",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.6.1",
    "mongodb-memory-server": "^9.4.1",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "5.4.5",
    "vitest": "^1.6.0"
  }
}
