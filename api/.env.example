NODE_ENV=development
PORT=4000

# Mongo (leave empty in dev to skip the connection)
MONGODB_URI=

# JWT — replace in prod with 64 random bytes (base64)
JWT_SECRET=change-me-dev-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
JOB_SECRET=change-me-dev-only

# Origins
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
COOKIE_DOMAIN=localhost

# Email (resend | sendgrid | brevo | stub)
# SendGrid is the implicit fallback when the primary is non-SendGrid and
# SENDGRID_API_KEY is set (M9 — see api/src/integrations/index.ts).
EMAIL_PROVIDER=stub
RESEND_API_KEY=
SENDGRID_API_KEY=
BREVO_API_KEY=
EMAIL_FROM="India Learns <notifications@app.indialearns.com>"

# WhatsApp (Meta WABA Cloud)
WHATSAPP_ENABLED=false
META_WABA_PHONE_ID=
META_WABA_ACCESS_TOKEN=

# Storage (s3 | mongo | cloudinary | stub)
# - s3:         AWS S3 (default in prod). Set AWS_* vars below.
# - mongo:      legacy GridFS in the app's Atlas DB.
# - cloudinary: Cloudinary CDN (kept as an option).
# - stub:       in-memory (tests / local dev without any provider).
STORAGE_PROVIDER=stub

# AWS S3 (used when STORAGE_PROVIDER=s3). Region fixed to ap-south-1
# (Mumbai) to match the Atlas cluster and DPDP Act 2023 data-residency
# alignment from CLAUDE.md §3.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: override the S3 endpoint for LocalStack / MinIO in tests.
AWS_S3_ENDPOINT=
AWS_S3_SIGNED_URL_TTL_SEC=300

# Cloudinary (used when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Certifier
CERTIFIER_ENABLED=false
CERTIFIER_API_KEY=
CERTIFIER_DEFAULT_TEMPLATE_ID=

# Receipts / org (PENDING per Logan Q-PENDING-02)
RECEIPT_ORG_NAME="India Learns"
RECEIPT_ORG_ADDRESS=PENDING
RECEIPT_ORG_GSTIN=
RECEIPT_LOGO_URL=

# Auth rate limits
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW_MIN=15
LOGIN_LOCK_AFTER=10
LOGIN_LOCK_DURATION_MIN=30

# Argon2id password hashing (TRD §7)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=1

# Token TTLs + session cap
INVITE_TOKEN_TTL_DAYS=7
RESET_TOKEN_TTL_MIN=30
SESSION_CAP=5

# Integration mode (stub = ConsoleEmailAdapter / ConsoleWhatsAppAdapter)
INTEGRATIONS_MODE=stub

# Cookies — set to true in production (HTTPS)
COOKIE_SECURE=false

# Super-admin seed (used by `npm run seed:superadmin -w api`)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=
SUPERADMIN_PHONE=

# Logging
LOG_LEVEL=info

# Sentry (M9 — Runbook §7). Empty DSN = no-op so dev/test require no setup.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=development

# Set automatically by CI / Render in prod
GIT_SHA=dev
